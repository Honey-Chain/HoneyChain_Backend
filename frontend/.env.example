# ========================================================
# HoneyChain Frontend Environment Configuration
# ========================================================

# Public URL of the Express backend API & Socket.IO server
# In local development: http://localhost:5000
# In production on Render: https://honeychain-backend-trag.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional Contract Address override for explorer links (defaults to deployed Sepolia contract)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xFc7211528ae5Ef5B302e7807F956e5e306903487

# Feature flags
NEXT_PUBLIC_ENABLE_REGISTER=true

# Optional CARTO basemap API key (Default is OpenStreetMap which is 100% free and requires NO key)
# NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

